generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  FILL_BLANK
  SHORT_ANSWER
  ESSAY
  CODING
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum ExamType {
  PRACTICE
  MOCK
  FINAL
  QUIZ
  DAILY
  WEEKLY
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  EVALUATED
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  password        String
  role            Role
  isEmailVerified Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  verificationTokens VerificationToken[]
  subjectsCreated    Subject[]           @relation("SubjectCreator")
  questionsCreated   Question[]          @relation("QuestionCreator")
  examsCreated       Exam[]              @relation("ExamCreator")
  examAttempts       ExamAttempt[]       @relation("StudentAttempts")
  certificates       Certificate[]       @relation("StudentCertificates")
  notifications      Notification[]
}

model VerificationToken {
  id        String              @id @default(cuid())
  userId    String
  code      String
  purpose   VerificationPurpose
  expiresAt DateTime
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([code, purpose])
  @@index([expiresAt])
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?  @db.Text
  createdById String
  createdAt   DateTime @default(now())

  createdBy User       @relation("SubjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  questions Question[]
  exams     Exam[]

  @@index([createdById])
}

model Exam {
  id                 String     @id @default(cuid())
  title              String
  subjectId          String
  examType           ExamType
  durationMinutes    Int
  totalMarks         Int        @default(0)
  passingMarks       Int
  startTime          DateTime?
  endTime            DateTime?
  status             ExamStatus @default(DRAFT)
  shuffleQuestions   Boolean    @default(false)
  shuffleOptions     Boolean    @default(false)
  fullScreenRequired Boolean    @default(true)
  tabSwitchLimit     Int?
  webcamRequired     Boolean    @default(false)
  createdById        String
  createdAt          DateTime   @default(now())

  subject      Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdBy    User           @relation("ExamCreator", fields: [createdById], references: [id], onDelete: Restrict)
  questions    ExamQuestion[]
  attempts     ExamAttempt[]
  certificates Certificate[]

  @@index([subjectId])
  @@index([createdById])
  @@index([status, startTime])
}

model Question {
  id                String          @id @default(cuid())
  subjectId         String
  type              QuestionType
  text              String          @db.Text
  difficulty        DifficultyLevel
  marks             Int
  correctAnswerText String?         @db.Text
  createdById       String
  createdAt         DateTime        @default(now())

  subject        Subject          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdBy      User             @relation("QuestionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  options        QuestionOption[]
  exams          ExamQuestion[]
  studentAnswers StudentAnswer[]

  @@index([subjectId])
  @@index([createdById])
  @@index([type, difficulty])
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  text       String  @db.Text
  isCorrect  Boolean
  order      Int

  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentAnswers StudentAnswer[]

  @@unique([questionId, order])
  @@index([questionId])
}

model ExamQuestion {
  id            String @id @default(cuid())
  examId        String
  questionId    String
  order         Int
  marksOverride Int?

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([examId, questionId])
  @@unique([examId, order])
  @@index([questionId])
}

model ExamAttempt {
  id             String        @id @default(cuid())
  examId         String
  studentId      String
  startedAt      DateTime      @default(now())
  submittedAt    DateTime?
  status         AttemptStatus @default(IN_PROGRESS)
  score          Float?
  percentage     Float?
  rank           Int?
  tabSwitchCount Int           @default(0)
  createdAt      DateTime      @default(now())

  exam    Exam            @relation(fields: [examId], references: [id], onDelete: Restrict)
  student User            @relation("StudentAttempts", fields: [studentId], references: [id], onDelete: Restrict)
  answers StudentAnswer[]

  @@index([examId])
  @@index([studentId])
  @@index([examId, status])
  @@index([studentId, createdAt])
}

model StudentAnswer {
  id               String   @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  answerText       String?  @db.Text
  isCorrect        Boolean?
  marksAwarded     Float?

  attempt        ExamAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOption QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@index([selectedOptionId])
}

model Certificate {
  id        String   @id @default(cuid())
  studentId String
  examId    String
  issuedAt  DateTime @default(now())
  fileUrl   String

  student User @relation("StudentCertificates", fields: [studentId], references: [id], onDelete: Restrict)
  exam    Exam @relation(fields: [examId], references: [id], onDelete: Restrict)

  @@unique([studentId, examId])
  @@index([examId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}
